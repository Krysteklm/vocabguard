<resources>
    <style name="Theme.VocabGuard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vg_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- No window animation: the lock should replace TikTok instantly, not slide over it. -->
    <style name="Theme.VocabGuard.Lock">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
